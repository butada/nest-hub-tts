HOST=0.0.0.0
PORT=8080

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_STYLE=自然で聞き取りやすく、与えられたテキストを内容を変えずに読み上げる
GEMINI_TIMEOUT_SECONDS=60
GEMINI_BATCH_POLL_INTERVAL_SECONDS=10
AUDIO_PROFILE=clear_speech
AUDIO_SPEED=1.08
MAX_TEXT_LENGTH=4000

# REST authentication. Leave empty only for local development.
API_TOKEN=

# The URL that the Nest Hub can fetch. Use the Mac's LAN address during evaluation
# and the Docker host's LAN address in production.
MEDIA_PUBLIC_BASE_URL=http://192.168.50.203:8080
MEDIA_DIR=./data/media
MEDIA_TTL_SECONDS=3600
MEDIA_SIGNING_SECRET=change-this-media-secret
BATCH_DB_PATH=./data/jobs.sqlite3
AUDIO_CACHE_DIR=./data/audio-cache
AUDIO_CACHE_TTL_SECONDS=2592000
AUDIO_URL_TTL_SECONDS=86400

# JSON object keyed by the device_id used by n8n.
CAST_DEVICES_JSON={"living-room":{"name":"リビング","host":"192.168.50.57","uuid":"1c5ab99e-ad4c-c9dc-23f5-cbff043675be","model":"Google Nest Hub"}}
CAST_TIMEOUT_SECONDS=10
